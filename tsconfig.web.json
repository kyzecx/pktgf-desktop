{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@engine/*": ["src/engine/*"],
      "@ui/*": ["src/renderer/ui/*"],
      "@features/*": ["src/renderer/features/*"],
      "@/*": ["src/renderer/*"]
    }
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "src/engine/**/*.ts"
  ]
}
